# GPU worker: Whisper ASR (transformers / faster-whisper), pyannote diarization, Silero VAD.
# CUDA runtime libraries come from the PyTorch / NVIDIA pip wheels; the host only
# needs the NVIDIA driver and the NVIDIA container toolkit.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/hf
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
RUN mkdir app && touch app/__init__.py && pip install ".[gpu]" && rm -rf app
COPY . .
RUN pip install --no-deps . && useradd -r -u 10001 sauti && mkdir -p /models /data/storage && chown -R sauti /models /data
# faster-whisper (CTranslate2) loads cuBLAS / cuDNN from the NVIDIA pip packages.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib
USER sauti
CMD ["celery", "-A", "app.workers.celery_app", "worker", "-Q", "gpu", "--concurrency", "1", "--loglevel", "INFO", "-n", "gpu@%h"]
