# =============================================================================
# Sauti QA configuration. Copy to .env and edit. Every value has a safe default
# unless marked REQUIRED. Nothing is sent outside your network unless you choose
# a cloud provider below (ASR_PROVIDER=openai or LLM_PROVIDER=anthropic).
# =============================================================================

# ---- Deployment --------------------------------------------------------------
ENV=prod
# REQUIRED: long random string (signs sessions). e.g. `openssl rand -hex 32`
SECRET_KEY=
# Public address of the site, used in report links.
PUBLIC_BASE_URL=https://qa.example.co.tz
# Caddy: DNS name (automatic HTTPS), or ":80" for plain HTTP while testing.
SITE_ADDRESS=qa.example.co.tz
# Leave empty for Let's Encrypt. Use "tls internal" for an internal-only name
# (Caddy issues its own certificate; install its root CA on analyst PCs), or
# "tls /certs/cert.pem /certs/key.pem" with a mounted corporate certificate.
TLS_DIRECTIVE=
# Session cookie only over HTTPS (keep true in production).
COOKIE_SECURE=true
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=["https://qa.example.co.tz"]

# First admin, created on first start when there are no users. Change the
# password after signing in, then remove these two lines.
BOOTSTRAP_ADMIN_EMAIL=admin@example.co.tz
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Database, queue, storage -----------------------------------------------
POSTGRES_USER=sauti
# REQUIRED
POSTGRES_PASSWORD=
POSTGRES_DB=sauti
# s3 = MinIO container (recommended); local = files on the storage volume.
STORAGE_BACKEND=s3
MINIO_ROOT_USER=sauti
# REQUIRED (min. 8 characters)
MINIO_ROOT_PASSWORD=
S3_BUCKET=sauti-audio

# ---- Ingestion ------------------------------------------------------------------
MAX_UPLOAD_MB=200
# Inbox folder polling (SFTP drops). The folder is the "inbox" volume.
INBOX_POLL_SECONDS=5
INBOX_STABLE_SECONDS=3
# Optional built-in SFTP server (docker compose --profile sftp)
SFTP_USER=recorder
SFTP_PASSWORD=
SFTP_PORT=2222

# ---- Audio ----------------------------------------------------------------------
# silero (GPU image) | energy (simple, CPU) | none
VAD_BACKEND=silero
# Default agent side for stereo recordings (admins can change it in Settings).
STEREO_AGENT_CHANNEL=left
# Silence spoken personal data in the playback copy (needs word timestamps:
# faster_whisper or openai providers).
MUTE_REDACTED_AUDIO=false

# ---- Speech-to-text ---------------------------------------------------------------
# mock | openchs | buzzasr | faster_whisper | hf_whisper | openai
#   buzzasr        BuzzASR/swahili (Whisper large-v3 fine-tuned on Swahili) - recommended start
#   openchs        openchs/asr-whisper-largev2-v6 (Tanzanian helpline calls; gated, request access)
#   faster_whisper Whisper large-v3 via CTranslate2 (fastest; ASR_MODEL may point to a converted fine-tune)
#   hf_whisper     any transformers Whisper checkpoint in ASR_MODEL (e.g. your fine-tuned model)
#   openai         OpenAI-compatible /audio/transcriptions endpoint. Cloud: ONLY with client approval.
#   mock           canned Swahili dialogue for demos/tests (no GPU)
ASR_PROVIDER=buzzasr
ASR_MODEL=
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=sw
# GPU only; CPU always decodes one region at a time (batching only adds memory there).
ASR_BATCH_SIZE=8
# Drop likely hallucinations (Whisper inventing text on noise/silence): segments
# below ASR_MIN_CONFIDENCE, or below ASR_SHORT_MIN_CONFIDENCE when shorter than
# ASR_SHORT_SECONDS. Set ASR_MIN_CONFIDENCE=0 and ASR_SHORT_MIN_CONFIDENCE=0 to keep everything.
ASR_MIN_CONFIDENCE=0.35
ASR_SHORT_MIN_CONFIDENCE=0.45
ASR_SHORT_SECONDS=2.0
ASR_OPENAI_BASE_URL=
ASR_OPENAI_API_KEY=
# After models are downloaded (scripts/download_models.py) set to 1 to run fully offline.
HF_HUB_OFFLINE=0

# ---- Speaker separation (mono calls) ------------------------------------------
# pyannote | none
DIARIZATION_BACKEND=pyannote
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Hugging Face token, only needed once to download the gated pyannote weights.
HF_TOKEN=

# ---- LLM scoring ------------------------------------------------------------------
# anthropic | openai | mock
#   anthropic  Claude via Anthropic's API. Sends redacted transcripts to Anthropic: prototyping / baseline.
#   openai     any OpenAI-compatible server (vLLM, Ollama, TGI) - use this for on-prem production.
LLM_PROVIDER=mock
# anthropic default: claude-sonnet-5-5. openai: the served model name, e.g. Qwen/Qwen3-32B
LLM_MODEL=
ANTHROPIC_API_KEY=
# Anthropic: server-side fallback model if a request is declined ("" to disable).
ANTHROPIC_FALLBACKS=default
# Anthropic: low | medium | high | xhigh | max (empty = model default)
LLM_EFFORT=
# e.g. http://vllm:8000/v1 or http://ollama:11434/v1
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=not-needed
# auto tries json_schema, then json_object, then plain text
LLM_JSON_MODE=auto
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=180
# Ask the LLM which diarized speaker is the agent (falls back to heuristics).
LLM_SPEAKER_IDENTIFICATION=true

# ---- Review routing defaults (also editable in Settings) -----------------------
REVIEW_SCORE_THRESHOLD=80
REVIEW_CONFIDENCE_THRESHOLD=0.6
REVIEW_ON_FLAGS=true
REVIEW_ON_AUTO_FAIL=true

# ---- Data protection ----------------------------------------------------------------
# Delete call audio after N days (0 = keep). Redacted transcripts and scores stay.
AUDIO_RETENTION_DAYS=90

# ---- Workers ----------------------------------------------------------------------
# Without a GPU worker (mock or cloud ASR) add ",gpu" so transcription still runs.
CPU_WORKER_QUEUES=cpu,llm,maintenance
CPU_WORKER_CONCURRENCY=4
GPU_COUNT=1
JOB_STUCK_MINUTES=30
JOB_MAX_ATTEMPTS=3

# ---- Reports ----------------------------------------------------------------------
# Custom Excel layout (see backend/seed/report_layout.yaml)
REPORT_LAYOUT_PATH=
